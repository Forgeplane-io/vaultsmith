{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["auth"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" }
      }
    },
    "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "passwordEnv", "passwordSecretKey"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "label": { "type": "string", "minLength": 1 },
          "passwordEnv": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "passwordSecretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
        },
        "not": {
          "properties": {
            "passwordEnv": { "enum": ["VAULT_PROFILES_JSON", "HTTP_ADDR"] }
          }
        }
      }
    },
    "secret": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "valkey": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "nameOverride": { "type": "string" },
        "fullnameOverride": { "type": "string" },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean", "const": false }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": { "type": "object" },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "denyAllIngress": { "type": "boolean" },
        "allowedIngress": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "namespaceSelector": { "type": "object", "minProperties": 1 },
              "podSelector": { "type": "object", "minProperties": 1 }
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "allowedEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "to": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "ipBlock": {
                      "type": "object",
                      "required": ["cidr"],
                      "properties": {
                        "cidr": { "type": "string", "minLength": 1 },
                        "except": {
                          "type": "array",
                          "minItems": 1,
                          "items": { "type": "string", "minLength": 1 }
                        }
                      },
                      "additionalProperties": false
                    },
                    "namespaceSelector": { "type": "object", "minProperties": 1 },
                    "podSelector": { "type": "object", "minProperties": 1 }
                  },
                  "additionalProperties": false,
                  "minProperties": 1,
                  "anyOf": [
                    { "required": ["ipBlock"] },
                    { "required": ["namespaceSelector"] },
                    { "required": ["podSelector"] }
                  ]
                }
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "protocol": { "type": "string", "enum": ["TCP", "UDP", "SCTP"] },
                    "port": {
                      "oneOf": [
                        { "type": "integer", "minimum": 1, "maximum": 65535 },
                        { "type": "string", "minLength": 1 }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false,
            "minProperties": 1,
            "anyOf": [
              { "required": ["to"] },
              { "required": ["ports"] }
            ]
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["mode", "csrf", "oidc", "redis", "policy", "session", "cors"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["native", "off"]
        },
        "csrf": {
          "type": "object",
          "required": ["key"],
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "oidc": {
          "type": "object",
          "required": ["issuerURL", "clientID", "clientSecret", "redirectURL", "publicBaseURL", "ca", "scopes", "groupsClaim"],
          "properties": {
            "issuerURL": { "type": "string" },
            "clientID": { "type": "string" },
            "clientSecret": {
              "type": "object",
              "required": ["existingSecret", "key"],
              "properties": {
                "existingSecret": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            },
            "redirectURL": { "type": "string" },
            "publicBaseURL": { "type": "string" },
            "ca": {
              "type": "object",
              "required": ["existingConfigMap", "key"],
              "properties": {
                "existingConfigMap": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            },
            "scopes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "groupsClaim": { "type": "string", "minLength": 1 }
          }
        },
        "redis": {
          "type": "object",
          "required": ["address", "username", "password", "database", "tls", "connectTimeout", "readTimeout", "writeTimeout", "poolSize", "keyPrefix"],
          "properties": {
            "address": { "type": "string" },
            "username": { "type": "string" },
            "password": {
              "type": "object",
              "required": ["existingSecret", "key"],
              "properties": {
                "existingSecret": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            },
            "database": { "type": "integer", "minimum": 0 },
            "tls": { "type": "boolean" },
            "connectTimeout": { "type": "string", "minLength": 1 },
            "readTimeout": { "type": "string", "minLength": 1 },
            "writeTimeout": { "type": "string", "minLength": 1 },
            "poolSize": { "type": "integer", "minimum": 1 },
            "keyPrefix": { "type": "string", "minLength": 1 }
          }
        },
        "policy": {
          "type": "object",
          "required": ["existingConfigMap", "key", "data"],
          "properties": {
            "existingConfigMap": { "type": "string" },
            "key": { "type": "string", "minLength": 1 },
            "data": { "type": "string" }
          }
        },
        "session": {
          "type": "object",
          "required": ["absoluteLifetime", "idleLifetime", "secure", "sameSite"],
          "properties": {
            "absoluteLifetime": { "type": "string", "minLength": 1 },
            "idleLifetime": { "type": "string", "minLength": 1 },
            "secure": { "type": "boolean" },
            "sameSite": { "type": "string", "enum": ["lax", "strict", "none"] }
          }
        },
        "cors": {
          "type": "object",
          "required": ["allowedOrigins"],
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^https://[^*]+$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "native" } } },
          "then": {
            "required": ["oidc", "redis", "policy"],
            "properties": {
              "oidc": {
                "required": ["issuerURL", "clientID", "clientSecret", "redirectURL", "publicBaseURL"],
                "properties": {
                  "issuerURL": { "minLength": 1, "pattern": "^https://" },
                  "clientID": { "minLength": 1 },
                  "clientSecret": {
                    "properties": {
                      "existingSecret": { "minLength": 1 }
                    }
                  },
                  "redirectURL": { "minLength": 1, "pattern": "^https://" },
                  "publicBaseURL": { "minLength": 1, "pattern": "^https://" }
                }
              },
              "csrf": {
                "required": ["existingSecret"],
                "properties": {
                  "existingSecret": { "minLength": 1 }
                }
              },
              "redis": {
                "properties": {
                  "keyPrefix": { "minLength": 1 }
                }
              },
              "session": { "properties": { "secure": { "const": true }, "sameSite": { "enum": ["lax", "none"] } } },
              "policy": {
                "oneOf": [
                  {
                    "properties": {
                      "data": { "minLength": 1 }
                    },
                    "required": ["data"],
                    "not": {
                      "properties": {
                        "existingConfigMap": { "minLength": 1 }
                      },
                      "required": ["existingConfigMap"]
                    }
                  },
                  {
                    "properties": {
                      "existingConfigMap": { "minLength": 1 }
                    },
                    "required": ["existingConfigMap"],
                    "not": {
                      "properties": {
                        "data": { "minLength": 1 }
                      },
                      "required": ["data"]
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "if": {
    "properties": {
      "profiles": { "minItems": 1 }
    }
  },
  "then": {
    "properties": {
      "secret": {
        "required": ["existingSecret"]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["valkey"],
        "properties": {
          "auth": {
            "properties": {
              "mode": { "const": "native" }
            }
          },
          "valkey": {
            "properties": {
              "enabled": { "const": false }
            }
          }
        }
      },
      "then": {
        "properties": {
          "auth": {
            "properties": {
              "redis": {
                "properties": {
                  "address": { "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  ]
}
