{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["auth"],
  "properties": {
    "auth": {
      "type": "object",
      "required": ["mode", "csrf", "oidc", "redis", "policy", "session", "cors"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["native", "off"]
        },
        "csrf": {
          "type": "object",
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "oidc": {
          "type": "object",
          "required": ["issuerURL", "clientID", "clientSecret", "redirectURL", "publicBaseURL", "ca", "scopes", "groupsClaim"],
          "properties": {
            "issuerURL": { "type": "string" },
            "clientID": { "type": "string" },
            "clientSecret": {
              "type": "object",
              "required": ["existingSecret", "key"],
              "properties": {
                "existingSecret": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            },
            "redirectURL": { "type": "string" },
            "publicBaseURL": { "type": "string" },
            "ca": {
              "type": "object",
              "required": ["existingConfigMap", "key"],
              "properties": {
                "existingConfigMap": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            },
            "scopes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "groupsClaim": { "type": "string", "minLength": 1 }
          }
        },
        "redis": {
          "type": "object",
          "required": ["address", "username", "password", "database", "tls", "connectTimeout", "readTimeout", "writeTimeout", "poolSize", "keyPrefix"],
          "properties": {
            "address": { "type": "string" },
            "username": { "type": "string" },
            "password": {
              "type": "object",
              "required": ["existingSecret", "key"],
              "properties": {
                "existingSecret": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            },
            "database": { "type": "integer", "minimum": 0 },
            "tls": { "type": "boolean" },
            "connectTimeout": { "type": "string", "minLength": 1 },
            "readTimeout": { "type": "string", "minLength": 1 },
            "writeTimeout": { "type": "string", "minLength": 1 },
            "poolSize": { "type": "integer", "minimum": 1 },
            "keyPrefix": { "type": "string", "minLength": 1 }
          }
        },
        "policy": {
          "type": "object",
          "required": ["file", "existingConfigMap", "key", "data"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "existingConfigMap": { "type": "string" },
            "key": { "type": "string", "minLength": 1 },
            "data": { "type": "string" }
          }
        },
        "session": {
          "type": "object",
          "required": ["absoluteLifetime", "idleLifetime", "secure", "sameSite"],
          "properties": {
            "absoluteLifetime": { "type": "string", "minLength": 1 },
            "idleLifetime": { "type": "string", "minLength": 1 },
            "secure": { "type": "boolean" },
            "sameSite": { "type": "string", "enum": ["lax", "strict", "none"] }
          }
        },
        "cors": {
          "type": "object",
          "required": ["allowedOrigins"],
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^https://[^*]+$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "native" } } },
          "then": {
            "required": ["oidc", "redis", "policy"],
            "properties": {
              "oidc": {
                "required": ["issuerURL", "clientID", "clientSecret", "redirectURL", "publicBaseURL"],
                "properties": {
                  "issuerURL": { "minLength": 1, "pattern": "^https://" },
                  "clientID": { "minLength": 1 },
                  "clientSecret": {
                    "properties": {
                      "existingSecret": { "minLength": 1 }
                    }
                  },
                  "redirectURL": { "minLength": 1, "pattern": "^https://" },
                  "publicBaseURL": { "minLength": 1, "pattern": "^https://" }
                }
              },
              "redis": {
                "required": ["address", "keyPrefix"],
                "properties": {
                  "address": { "minLength": 1 },
                  "keyPrefix": { "minLength": 1 }
                }
              },
              "session": { "properties": { "secure": { "const": true } } },
              "policy": {
                "anyOf": [
                  { "required": ["data"] },
                  { "required": ["existingConfigMap"] }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
